@article{AbatayoLynhamEE2023,
 abstract = {Climate change is altering the dynamics of common pool resources around the world. We design an experimental game that varies both the flow of natural resources and the group punishment mechanisms available to resource users. Our experiments show that subjects are more likely to over-harvest when resource flows are high. But group punishment mechanisms that rely on social ostracism (as opposed to fines or fees) are more effective at mediating the desire to over-harvest when resources are booming. This suggests that collective management systems based on social norms, exclusion, and ostracism may be more resilient to unexpected changes in resource dynamics and supports bottom-up, as opposed to top-down, management of common pool resources.},
 author = {Abatayo, Anna Lou and Lynham, John},
 doi = {10.1016/j.ecolecon.2022.107730},
 journal = {Ecological Economics},
 keywords = {Resource curse,Common pool resources,Social ostracism},
 number = {107730},
 pages = {107730},
 title = {Resource booms and group punishment in a coupled social-ecological system},
 volume = {206},
 year = {2023}
}

